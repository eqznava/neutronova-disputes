# Copy this file to .env and fill in your own values. Never commit .env.

# Display name of the app.
APP_NAME=Neutronova Disputes

# "mock" = simulated data, no keys needed. "sandbox" = PayPal Sandbox (needs the two keys below).
PAYPAL_MODE=mock

# PayPal Developer Dashboard > Apps & Credentials > Sandbox > your app.
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
# Optional: the webhook ID from your Sandbox app, to verify incoming dispute webhooks.
PAYPAL_WEBHOOK_ID=

# Optional: with a key the agent uses Claude; without one it runs the rules engine (free).
ANTHROPIC_API_KEY=
# Cheapest first. Switch to claude-sonnet-5-5 or Fable only if you need it.
ANTHROPIC_MODEL=claude-haiku-5-5
# economy = one AI call per case, only when needed (default). agent = full tool loop, several calls.
AGENT_STYLE=economy
# Hard cap on AI calls per day. Past it, the rules engine takes over at no cost.
AI_MAX_CALLS_PER_DAY=25

# Prevent mode: orders at or above this amount get a signature-confirmation warning.
SIGNATURE_THRESHOLD=750

# Optional basic auth for a public demo URL.
DEMO_USER=
DEMO_PASSWORD=

PORT=3000
